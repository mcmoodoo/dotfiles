{
  "layer": "top",
  "position": "top",
  "height": 36,
  "margin": "6, 10, 0, 10",

  "modules-left": [
    "cpu",
    "custom/separator",
    "memory",
    "custom/separator",
    "network"
  ],

  "modules-center": [
    "hyprland/workspaces"
  ],

  "modules-right": [
    "hyprland/windows",
    "custom/separator",
    "group/recording",
    "custom/separator",
    "pulseaudio",
    "custom/separator",
    "backlight",
    "custom/separator",
    "battery",
    "custom/separator",
    "custom/energy-rate",
    "custom/separator",
    "clock",
    "custom/separator",
    "tray"
  ],

  "group/recording": {
    "orientation": "horizontal",
    "modules": ["custom/recorder", "custom/audiorec"]
  },

  "custom/separator": {
    "format": "│",
    "interval": "once",
    "tooltip": false
  },

  "tray": {
    "icon-size": 14,
    "spacing": 8
  },

  "clock": {
    "interval": 1,
    "locale": "C",
    "format": " {:%I:%M %p}",
    "format-alt": " {:%a, %b %d}"
  },

  "cpu": {
    "format": " {usage}%",
    "tooltip": false,
    "on-click": "alacritty -e btm"
  },

  "memory": {
    "interval": 30,
    "format": " {used:0.1f}G",
    "on-click": "alacritty -e btm",
    "max-length": 10,
    "tooltip": false,
    "warning": 70,
    "critical": 90
  },

  "backlight": {
    "format": " {percent}%",
    "on-scroll-down": "brightnessctl -c backlight set 1%-",
    "on-scroll-up": "brightnessctl -c backlight set +1%"
  },

  "battery": {
    "states": { "good": 95, "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{icon} {time}",
    "format-icons": ["","","","",""]
  },

  "network": {
    "format-wifi": " {signalStrength}%",
    "format-ethernet": "󰈁 {ipaddr}",
    "format-linked": "󰌘",
    "format-disconnected": "󰖪",
    "format-alt": "{ifname}: {ipaddr}/{cidr}",
    "tooltip-format": "{essid}: {ipaddr}"
  },

  "pulseaudio": {
    "format": "{icon} {volume}% {format_source}",
    "format-bluetooth": "{icon} {volume}% {format_source}",
    "format-bluetooth-muted": " {format_source}",
    "format-muted": " {format_source}",
    "format-source": " {volume}%",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "🎧",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["","",""]
    },
    "on-click": "pavucontrol"
  },

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "default": "",
      "active": "",
      "urgent": ""
    }
  },

  "hyprland/windows": {
    "format": "{}",
    "max-length": 60,
    "separate-outputs": false,
    "rewrite": {
      "(.*) — (.*)": "$1"
    },
    "tooltip": false
  },

  "custom/energy-rate": {
    "interval": 1,
    "exec": "upower -e | rg BAT | xargs -I{} upower -i {} | rg -m1 'energy-rate' | awk '{print $2, $3}'"
  },

  "custom/recorder": {
    "format": " Rec",
    "format-disabled": " Off-air",
    "return-type": "json",
    "interval": 1,
    "exec": "echo '{\"class\": \"recording\"}'",
    "exec-if": "pgrep wf-recorder"
  },

  "custom/audiorec": {
    "format": "♬ Rec",
    "format-disabled": "♬ Off-air",
    "return-type": "json",
    "interval": 1,
    "exec": "echo '{\"class\": \"audio recording\"}'",
    "exec-if": "pgrep ffmpeg"
  }
}

